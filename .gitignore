# Root reference checkouts are reconstructed by tools/fetch-references.sh.
/.references/

# Reference checkouts and local build products inside ports are never source.
/.ports/**/.reference/
/.ports/**/.references/
/.ports/**/.zig-cache/
/.ports/**/zig-out/
/.ports/**/zig-pkg/
/.ports/**/target/

# Buildable binaries that happen to match a step's output name are never
# source: a9MB `root` ELF was committed from .ports/vellz before this rule.
/.ports/**/root

# Root build products and local tool state.
/zig-out/
/zig-pkg/
/.zig-cache/
**/zig-out/
**/zig-pkg/
**/.zig-cache/
**/__pycache__/
*.py[cod]
/target/
**/target/
*.AppImage
*.aria2
/.zig-global/
/.zig-cache-layout/
/.opencode/
